ANTHROPIC_API_KEY=sk-ant-...
HF_TOKEN=hf_...
TWITTER_BEARER_TOKEN=AAAA...

# Email delivery (see README for Gmail App Password setup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_TO=youraddress@gmail.com           # comma-separate multiple addresses, e.g. a@x.com,b@x.com

# Ticker watchlist alerts (one ticker per line in watchlist.txt, # comments ignored)
# Optional - missing/empty file means alerts are skipped, not fatal
# Alert emails are OFF unless WATCHLIST_ALERTS is set to 1/true/yes/on. Tickers are
# still extracted for Notion sync when off; summary emails are unaffected either way.
WATCHLIST_ALERTS=false
WATCHLIST_FILE=watchlist.txt

# Notion sync (see README for one-time integration/database setup)
# NOTION_TOKEN is the internal integration token from notion.so/my-integrations
# NOTION_DATABASE_ID comes from the database's URL, once it's shared with the integration
NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=...

# ── Zoom ingest ───────────────────────────────────────────────────────────────
# Show name used in summaries and email subjects for Zoom episodes.
ZOOM_SHOW_NAME=Stock Talk Weekly
# Queue file of share links + passcodes (default: ./zoom_calls_input.txt)
ZOOM_INPUT_FILE=
# Set to 1 to watch the browser drive Zoom's passcode page — debugging only.
ZOOM_FETCH_HEADFUL=

# Netscape-format cookies.txt for x.com (default: ./cookies.txt if present)
COOKIES_FILE=

# ── Stall guards ──────────────────────────────────────────────────────────────
# Kill a download that writes no new bytes for this long (seconds, default 1200).
# Watches progress, not total time: a healthy Space once took 2h19m at 10 KiB/s,
# while a wedged one sat at 11 MB for 31 hours holding the state lock.
DOWNLOAD_STALL_SECONDS=
# Per-attempt Anthropic timeout in seconds (default 600) and retry count
# (default 3). Left unbounded, one summarization hung for four hours.
SUMMARIZE_TIMEOUT=
SUMMARIZE_RETRIES=
