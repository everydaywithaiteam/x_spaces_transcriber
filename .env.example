ANTHROPIC_API_KEY=sk-ant-...
HF_TOKEN=hf_...
TWITTER_BEARER_TOKEN=AAAA...

# Email delivery (see README for Gmail App Password setup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_TO=youraddress@gmail.com           # comma-separate multiple addresses, e.g. a@x.com,b@x.com

# Ticker watchlist alerts (one ticker per line in watchlist.txt, # comments ignored)
# Optional - missing/empty file means alerts are skipped, not fatal
# Alert emails are OFF unless WATCHLIST_ALERTS is set to 1/true/yes/on. Tickers are
# still extracted for Notion sync when off; summary emails are unaffected either way.
WATCHLIST_ALERTS=false
WATCHLIST_FILE=watchlist.txt

# Notion sync (see README for one-time integration/database setup)
# NOTION_TOKEN is the internal integration token from notion.so/my-integrations
# NOTION_DATABASE_ID comes from the database's URL, once it's shared with the integration
NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=...
